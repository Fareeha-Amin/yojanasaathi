# copy to .env and fill in; never commit .env

# --- agent (FastAPI, port 8000) ---
# comma-separated web origins allowed to call /turn
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (Phase 2) ---
# ollama (local, default) | openai (or OpenAI-compatible via LLM_BASE_URL) | anthropic
# | none (deterministic parsers only: the golden path still works)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_API_KEY=
LLM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
# seconds per LLM call before the turn falls back to the deterministic parsers
LLM_TIMEOUT=20
# load the model at agent startup and keep it loaded (first load ~1 min)
LLM_WARMUP=1
# local GPU: 1-token ping every N s so the GPU doesn't idle down between turns (0 = off)
LLM_KEEPWARM=2

# --- voice (Phase 1; separate process on port 7860) ---
# also used by the agent's POST /tts (web app read-aloud when the voice bot is off)
SARVAM_API_KEY=
# where the voice bot (and agent.cli) reach /turn
AGENT_URL=http://127.0.0.1:8000
# case used when the voice client doesn't send one (same default as the web app)
VOICE_CASE_ID=demo-case-1

# --- persistence & security (Phase 3); the agent does not start without these ---
DATABASE_URL=postgresql://user:pass@localhost:5432/yojanasaathi
# tests use their own database; default: DATABASE_URL's name + "_test" (dropped/created per run)
TEST_DATABASE_URL=
# 32-byte base64 key that wraps each document's own key. Generate:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing it makes every stored document unreadable.
MASTER_KEY=
# encrypted files (default data/vault, gitignored)
VAULT_DIR=
# documents are deleted this many hours after the case's latest submission
DOC_RETENTION_HOURS=24
VAULT_PURGE_SECONDS=60
# web app session tokens (Phase 5, JWT signed with a key derived from MASTER_KEY)
SESSION_TTL_HOURS=720

# --- mock portal (Phase 4): public URLs from Ayush; never assume localhost ---
# demo-day local fallback: http://127.0.0.1:5174 and http://127.0.0.1:8001/api
MOCK_PORTAL_URL=https://<ayush-portal-public-url>
# the API base: must end with /api
MOCK_PORTAL_API=https://<ayush-portal-public-url>/api
# the agent API key from Ayush (yjs_ag_...): a secret, never commit it
MOCK_PORTAL_AGENT_KEY=
# the API sleeps when idle (Render): the first call may take this long (s), later ones PORTAL_TIMEOUT
PORTAL_FIRST_TIMEOUT=90
PORTAL_TIMEOUT=20

# --- browser agent (Phase 4: Playwright Chromium, own thread) ---
# demo: BROWSER_HEADLESS=false and BROWSER_SLOWMO_MS=250 so the form is seen being filled
BROWSER_HEADLESS=true
BROWSER_SLOWMO_MS=0
# a case's browser session is closed after this many seconds without use
BROWSER_IDLE_SECONDS=900

# --- status tracking (Phase 6) ---
# the poller asks the portal about open applications this often (seconds): 30 for the demo,
# hours in real life. Errors / 429 back off 2x per failure, up to TRACK_BACKOFF_MAX
STATUS_POLL_SECONDS=300
# 0 turns the background polling off (the status question still checks the portal)
STATUS_POLL=1
TRACK_TIMEOUT=15
TRACK_NOW_TIMEOUT=8
TRACK_BACKOFF_MAX=900
# web push (backend only): python -m agent.tracking.push keys   prints the pair; secret!
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.org

# --- phone line (Phase 7) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
